<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:choreo="http://eda.com/choreography"
                  id="retry-loop-definitions" targetNamespace="http://eda.com/flows">
  <bpmn:process id="retry-loop" isExecutable="true" choreo:maxIterations="4">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_assess" name="assess" choreo:service="assess"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="again"><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>back</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_reserve" name="reserve" choreo:service="reserve"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_review" name="review" choreo:service="review"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="approved" name="enough rounds?" default="back"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>yes</bpmn:outgoing><bpmn:outgoing>back</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_notify" name="notify" choreo:service="notify"><bpmn:incoming>yes</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="Task_assess" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_assess" targetRef="again" />
    <bpmn:sequenceFlow id="f3" sourceRef="again" targetRef="Task_reserve" />
    <bpmn:sequenceFlow id="f4" sourceRef="Task_reserve" targetRef="Task_review" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_review" targetRef="approved" />
    <bpmn:sequenceFlow id="yes" name="visits &gt;= rounds" sourceRef="approved" targetRef="Task_notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['visits'] &gt;= (#result['rounds'] ?: 3)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="back" name="again" sourceRef="approved" targetRef="again" />
    <bpmn:sequenceFlow id="f6" sourceRef="Task_notify" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="retry-loop-diagram">
    <bpmndi:BPMNPlane id="retry-loop-plane" bpmnElement="retry-loop">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="200" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_assess_di" bpmnElement="Task_assess"><dc:Bounds x="180" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="again_di" bpmnElement="again" isMarkerVisible="true"><dc:Bounds x="330" y="193" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reserve_di" bpmnElement="Task_reserve"><dc:Bounds x="430" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_review_di" bpmnElement="Task_review"><dc:Bounds x="580" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approved_di" bpmnElement="approved" isMarkerVisible="true"><dc:Bounds x="730" y="193" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="712" y="250" width="86" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_notify_di" bpmnElement="Task_notify"><dc:Bounds x="830" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="980" y="200" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="136" y="218" /><di:waypoint x="180" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="280" y="218" /><di:waypoint x="330" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="380" y="218" /><di:waypoint x="430" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="530" y="218" /><di:waypoint x="580" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="680" y="218" /><di:waypoint x="730" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="yes_di" bpmnElement="yes"><di:waypoint x="780" y="218" /><di:waypoint x="830" y="218" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="195" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="back_di" bpmnElement="back"><di:waypoint x="755" y="193" /><di:waypoint x="755" y="120" /><di:waypoint x="355" y="120" /><di:waypoint x="355" y="193" /><bpmndi:BPMNLabel><dc:Bounds x="540" y="100" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="930" y="218" /><di:waypoint x="980" y="218" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
