<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:choreo="http://eda.com/choreography"
                  id="showcase-definitions" targetNamespace="http://eda.com/flows">
  <bpmn:process id="showcase" isExecutable="true" choreo:joinTimeout="PT3S" choreo:maxIterations="3">
    <bpmn:documentation>Every feature in one flow: a choice, a loop with a limit, a fork with a choice inside a branch, a join with a timeout, one service running two steps, and a late-bound service behind a choice.</bpmn:documentation>
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_assess" name="assess" choreo:service="assess"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="risk" name="large order?" default="low"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>high</bpmn:outgoing><bpmn:outgoing>low</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_review" name="review" choreo:service="review"><bpmn:incoming>high</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="again"><bpmn:incoming>low</bpmn:incoming><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>retry</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_reserve" name="reserve" choreo:service="reserve"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="reserved" name="reserved?" default="retry"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>ok</bpmn:outgoing><bpmn:outgoing>retry</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_accepted" name="notify: accepted" choreo:service="notify"><bpmn:incoming>ok</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="fork"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_pay" name="pay" choreo:service="pay"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ship" name="ship" choreo:service="ship"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="express" name="express?" default="standard"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>fast</bpmn:outgoing><bpmn:outgoing>standard</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_charge" name="charge" choreo:service="charge"><bpmn:incoming>fast</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="shipped"><bpmn:incoming>standard</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="join"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_confirm" name="confirm" choreo:service="confirm"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gift" name="gift?" default="plain"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>wrapit</bpmn:outgoing><bpmn:outgoing>plain</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_wrap" name="wrap" choreo:service="wrap"><bpmn:incoming>wrapit</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="wrapped"><bpmn:incoming>plain</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_done" name="notify: done" choreo:service="notify"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="Task_assess" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_assess" targetRef="risk" />
    <bpmn:sequenceFlow id="high" name="amount &gt; 1000" sourceRef="risk" targetRef="Task_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['amount'] &gt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="low" sourceRef="risk" targetRef="again" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_review" targetRef="again" />
    <bpmn:sequenceFlow id="f4" sourceRef="again" targetRef="Task_reserve" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_reserve" targetRef="reserved" />
    <bpmn:sequenceFlow id="ok" name="visits &gt;= rounds" sourceRef="reserved" targetRef="Task_accepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['visits'] &gt;= (#result['rounds'] ?: 1)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="retry" name="try again" sourceRef="reserved" targetRef="again" />
    <bpmn:sequenceFlow id="f6" sourceRef="Task_accepted" targetRef="fork" />
    <bpmn:sequenceFlow id="f7" sourceRef="fork" targetRef="Task_pay" />
    <bpmn:sequenceFlow id="f8" sourceRef="fork" targetRef="Task_ship" />
    <bpmn:sequenceFlow id="f9" sourceRef="Task_pay" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="Task_ship" targetRef="express" />
    <bpmn:sequenceFlow id="fast" name="express" sourceRef="express" targetRef="Task_charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['express'] == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="standard" sourceRef="express" targetRef="shipped" />
    <bpmn:sequenceFlow id="f11" sourceRef="Task_charge" targetRef="shipped" />
    <bpmn:sequenceFlow id="f12" sourceRef="shipped" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="join" targetRef="Task_confirm" />
    <bpmn:sequenceFlow id="f14" sourceRef="Task_confirm" targetRef="gift" />
    <bpmn:sequenceFlow id="wrapit" name="gift" sourceRef="gift" targetRef="Task_wrap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['gift'] == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="plain" sourceRef="gift" targetRef="wrapped" />
    <bpmn:sequenceFlow id="f15" sourceRef="Task_wrap" targetRef="wrapped" />
    <bpmn:sequenceFlow id="f16" sourceRef="wrapped" targetRef="Task_done" />
    <bpmn:sequenceFlow id="f17" sourceRef="Task_done" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="showcase-diagram">
    <bpmndi:BPMNPlane id="showcase-plane" bpmnElement="showcase">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="200" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_assess_di" bpmnElement="Task_assess"><dc:Bounds x="170" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risk_di" bpmnElement="risk" isMarkerVisible="true"><dc:Bounds x="310" y="193" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="300" y="250" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_review_di" bpmnElement="Task_review"><dc:Bounds x="390" y="70" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="again_di" bpmnElement="again" isMarkerVisible="true"><dc:Bounds x="520" y="193" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reserve_di" bpmnElement="Task_reserve"><dc:Bounds x="600" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reserved_di" bpmnElement="reserved" isMarkerVisible="true"><dc:Bounds x="740" y="193" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="735" y="175" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_accepted_di" bpmnElement="Task_accepted"><dc:Bounds x="830" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork"><dc:Bounds x="970" y="193" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_pay_di" bpmnElement="Task_pay"><dc:Bounds x="1060" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ship_di" bpmnElement="Task_ship"><dc:Bounds x="1060" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="express_di" bpmnElement="express" isMarkerVisible="true"><dc:Bounds x="1200" y="315" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1195" y="297" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_charge_di" bpmnElement="Task_charge"><dc:Bounds x="1290" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipped_di" bpmnElement="shipped" isMarkerVisible="true"><dc:Bounds x="1430" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join"><dc:Bounds x="1520" y="193" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_confirm_di" bpmnElement="Task_confirm"><dc:Bounds x="1610" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gift_di" bpmnElement="gift" isMarkerVisible="true"><dc:Bounds x="1750" y="193" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1760" y="250" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_wrap_di" bpmnElement="Task_wrap"><dc:Bounds x="1830" y="70" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wrapped_di" bpmnElement="wrapped" isMarkerVisible="true"><dc:Bounds x="1970" y="193" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_done_di" bpmnElement="Task_done"><dc:Bounds x="2050" y="178" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="2190" y="200" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="136" y="218" /><di:waypoint x="170" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="270" y="218" /><di:waypoint x="310" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="high_di" bpmnElement="high"><di:waypoint x="335" y="193" /><di:waypoint x="335" y="110" /><di:waypoint x="390" y="110" /><bpmndi:BPMNLabel><dc:Bounds x="290" y="92" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="low_di" bpmnElement="low"><di:waypoint x="360" y="218" /><di:waypoint x="520" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="490" y="110" /><di:waypoint x="545" y="110" /><di:waypoint x="545" y="193" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="570" y="218" /><di:waypoint x="600" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="700" y="218" /><di:waypoint x="740" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ok_di" bpmnElement="ok"><di:waypoint x="790" y="218" /><di:waypoint x="830" y="218" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="262" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="retry_di" bpmnElement="retry"><di:waypoint x="765" y="243" /><di:waypoint x="765" y="310" /><di:waypoint x="545" y="310" /><di:waypoint x="545" y="243" /><bpmndi:BPMNLabel><dc:Bounds x="630" y="316" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="930" y="218" /><di:waypoint x="970" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="995" y="193" /><di:waypoint x="995" y="100" /><di:waypoint x="1060" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="995" y="243" /><di:waypoint x="995" y="340" /><di:waypoint x="1060" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1160" y="100" /><di:waypoint x="1545" y="100" /><di:waypoint x="1545" y="193" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1160" y="340" /><di:waypoint x="1200" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fast_di" bpmnElement="fast"><di:waypoint x="1225" y="365" /><di:waypoint x="1225" y="440" /><di:waypoint x="1290" y="440" /><bpmndi:BPMNLabel><dc:Bounds x="1180" y="420" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="standard_di" bpmnElement="standard"><di:waypoint x="1250" y="340" /><di:waypoint x="1430" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1390" y="440" /><di:waypoint x="1455" y="440" /><di:waypoint x="1455" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1480" y="340" /><di:waypoint x="1545" y="340" /><di:waypoint x="1545" y="243" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1570" y="218" /><di:waypoint x="1610" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1710" y="218" /><di:waypoint x="1750" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="wrapit_di" bpmnElement="wrapit"><di:waypoint x="1775" y="193" /><di:waypoint x="1775" y="110" /><di:waypoint x="1830" y="110" /><bpmndi:BPMNLabel><dc:Bounds x="1750" y="92" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="plain_di" bpmnElement="plain"><di:waypoint x="1800" y="218" /><di:waypoint x="1970" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1930" y="110" /><di:waypoint x="1995" y="110" /><di:waypoint x="1995" y="193" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_di" bpmnElement="f16"><di:waypoint x="2020" y="218" /><di:waypoint x="2050" y="218" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_di" bpmnElement="f17"><di:waypoint x="2150" y="218" /><di:waypoint x="2190" y="218" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
